[Unit]
Description=Fixed bounded L0 live acceptance matrix
After=investment-static-oracle.service
Requires=investment-static-oracle.service

[Service]
Type=oneshot
User=investment-oracle
Group=investment-oracle
ExecStart=/usr/bin/python3 -I -S /opt/investment-static-oracle/live_acceptance.py
WorkingDirectory=/
UMask=0077
StateDirectory=investment-static-oracle-acceptance
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/investment-static-oracle/authority.git
ReadWritePaths=/run/investment-static-oracle /var/lib/investment-static-oracle-acceptance
InaccessiblePaths=-/home/optiplex/investment -/run/docker.sock -/var/run/docker.sock
MemoryMax=256M
TasksMax=16
CPUQuota=100%
TimeoutStopSec=10
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
