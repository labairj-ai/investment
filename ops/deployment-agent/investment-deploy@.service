[Unit]
Description=Owner-authorized exact-SHA investment deployment %i
After=network-online.target
[Service]
Type=oneshot
User=investment-deploy
Group=investment-deploy
WorkingDirectory=/opt/investment-deployment-controller
ExecStart=/opt/investment-deployment-controller/venv/bin/python -I /usr/local/libexec/investment-deploy.py --authorization-id %i
EnvironmentFile=/etc/investment-deploy/service.env
ExecStartPre=/opt/investment-deployment-controller/venv/bin/python -I /usr/local/libexec/investment-deploy-preflight.py
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/optiplex/investment /var/lib/investment-deploy
ReadOnlyPaths=/home/optiplex/.local/share/investment-development/development-control.sqlite3
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
TimeoutStartSec=1800

# Read-only protected state is separate from exact-code checkout authority.
ReadOnlyPaths=/home/optiplex/investment/out /home/optiplex/investment/holdings.csv
InaccessiblePaths=-/home/optiplex/investment/.env -/home/optiplex/.ssh -/home/optiplex/.aws -/home/optiplex/.config/gh -/home/optiplex/.local/share/investment-development/service.env
InaccessiblePaths=-/home/optiplex/.netrc -/home/optiplex/.git-credentials -/home/optiplex/.gnupg
