[Unit]
Description=Read-only GitHub queue poll for owner-authorized fixed deployments
[Service]
Type=oneshot
User=investment-deploy
Group=investment-deploy
WorkingDirectory=/opt/investment-deployment-controller
ExecStart=/opt/investment-deployment-controller/venv/bin/python -I /usr/local/libexec/investment-deploy-poller.py
EnvironmentFile=/etc/investment-deploy/service.env
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/optiplex/investment /var/lib/investment-deploy
ReadOnlyPaths=/home/optiplex/.local/share/investment-development/development-control.sqlite3
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
TimeoutStartSec=1800
