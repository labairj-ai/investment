[Unit]
Description=Run trade-runner 3x per weekday during US market hours (America/New_York)

[Timer]
# Timezone embedded in each OnCalendar= expression (TIMEZONE= is not a valid [Timer] directive).
# Validate with: systemd-analyze calendar "Mon..Fri *-*-* 09:45:00 America/New_York"
OnCalendar=Mon..Fri *-*-* 09:45:00 America/New_York
OnCalendar=Mon..Fri *-*-* 12:00:00 America/New_York
OnCalendar=Mon..Fri *-*-* 15:45:00 America/New_York

[Install]
WantedBy=timers.target
