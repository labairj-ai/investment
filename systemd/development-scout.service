[Unit]
Description=Investment development discovery only (no implementation)

RefuseManualStart=yes

[Service]
Type=oneshot
User=optiplex
Group=optiplex
WorkingDirectory=/home/optiplex/investment
ExecStartPre=/usr/bin/python3 -I -S /opt/investment-discovery-observer/observer.py begin
ExecStopPost=/usr/bin/python3 -I -S /opt/investment-discovery-observer/observer.py end
ExecStart=/usr/bin/python3 -I -S /opt/investment-discovery-observer/observer.py scout
EnvironmentFile=-/home/optiplex/.config/investment-development/discovery.env
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/optiplex/.local/share/investment-development
PrivateTmp=true
PrivateNetwork=true
TimeoutStartSec=180

# Discovery never receives portfolio, broker, owner or SSH credentials.
InaccessiblePaths=-/home/optiplex/.ssh -/home/optiplex/.aws -/home/optiplex/.config/gh -/home/optiplex/investment/.env -/home/optiplex/investment/out -/home/optiplex/investment/holdings.csv -/home/optiplex/.local/share/investment-development/service.env
InaccessiblePaths=-/home/optiplex/.netrc -/home/optiplex/.git-credentials -/home/optiplex/.gnupg

InaccessiblePaths=-/home/optiplex/.config/investment-development/github-read.token
