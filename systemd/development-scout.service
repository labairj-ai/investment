[Unit]
Description=Investment development discovery only (no implementation)

RefuseManualStart=yes

[Service]
Type=oneshot
WorkingDirectory=%h/investment
ExecStartPre=/usr/bin/python3 -I -S /opt/investment-discovery-observer/observer.py begin
ExecStopPost=/usr/bin/python3 -I -S /opt/investment-discovery-observer/observer.py end
ExecStart=/usr/bin/python3 -I -S /opt/investment-discovery-observer/observer.py scout
EnvironmentFile=-%h/.config/investment-development/discovery.env
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/investment-development
PrivateTmp=true
PrivateNetwork=true
TimeoutStartSec=180

# Discovery never receives portfolio, broker, owner or SSH credentials.
InaccessiblePaths=-%h/.ssh -%h/.aws -%h/.config/gh -%h/investment/.env -%h/investment/out -%h/investment/holdings.csv -%h/.local/share/investment-development/service.env
InaccessiblePaths=-%h/.netrc -%h/.git-credentials -%h/.gnupg

InaccessiblePaths=-%h/.config/investment-development/github-read.token
