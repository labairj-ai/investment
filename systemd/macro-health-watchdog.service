[Unit]
Description=Operational Watchdog — deterministic checks and alert delivery
After=network.target

[Service]
Type=oneshot
User=optiplex
WorkingDirectory=/home/optiplex/investment
ExecStart=/home/optiplex/investment/venv/bin/python3 scripts/macro_health_watchdog.py --notify
StandardOutput=journal
StandardError=journal
SyslogIdentifier=macro-health-watchdog
TimeoutStartSec=180
