[Unit]
Description=Read-only bounded operational metadata collector (no model/build)
[Service]
Type=oneshot
WorkingDirectory=%h/investment
ExecStart=%h/investment/venv/bin/python scripts/collect_development_signals.py --out %h/.local/share/investment-development/operational-signals.json
EnvironmentFile=-%h/.config/investment-development/collector.env
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/investment-development
PrivateTmp=true
TimeoutStartSec=120

# Discovery never receives portfolio, broker, owner or SSH credentials.
InaccessiblePaths=-%h/.ssh -%h/.aws -%h/.config/gh -%h/investment/.env -%h/investment/out -%h/investment/holdings.csv -%h/.local/share/investment-development/service.env
InaccessiblePaths=-%h/.netrc -%h/.git-credentials -%h/.gnupg
